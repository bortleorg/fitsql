# Normalize line endings: LF in the repo for everything text.
# Critical for files executed on Linux in the container (Dockerfile, yml, py, sh).
* text=auto eol=lf

# Windows-only helper stays CRLF
*.ps1 text eol=crlf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.fits binary
*.fit binary
