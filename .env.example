# Copy to .env and edit for your host. The .env is gitignored, so these survive
# `git pull` — no more hand-editing docker-compose.yml.

# Where persistent app state lives (DB, thumbnails, ASTAP star DB)
APPDATA_PATH=/mnt/user/appdata/fitsql

# Your astrophotography library (host path; mounted read-only at /mnt/astro)
MEDIA_PATH=/mnt/user/astro

# Web UI host port (container is 8000)
WEB_PORT=8400

# Read-only public API (/api/v1) keys, comma-separated. Empty = no key required.
PUBLIC_API_KEYS=

# Workers (scale container count with: docker compose up -d --scale worker=N)
WORKER_CONCURRENCY=2     # concurrent jobs per worker container
WORKER_CPUS=2.0          # hard CPU ceiling per worker
WORKER_MEM=3g            # memory ceiling per worker
